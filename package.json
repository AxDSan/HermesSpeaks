{
  "name": "hermes-speaks",
  "version": "2.0.0",
  "description": "HermesSpeaks - Lightweight AI text detection for Hermes Agent (<500MB RAM)",
  "main": "hermes-speaks.js",
  "bin": {
    "hermes-speaks": "./hermes-speaks.js"
  },
  "scripts": {
    "detect": "node hermes-speaks.js",
    "detect:heuristic": "node hermes-speaks.js --heuristic-only",
    "detect:json": "node hermes-speaks.js --json",
    "detect:compact": "node hermes-speaks.js --compact",
    "setup": "bash setup.sh",
    "test": "node tests/run-tests.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AxDSan/HermesSpeaks.git"
  },
  "keywords": [
    "ai-detection",
    "lightweight",
    "hermes",
    "onnx",
    "low-memory",
    "fly.io",
    "text-analysis"
  ],
  "author": "Hermes Agent (forked from Stop Slop Drop Top)",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/AxDSan/HermesSpeaks/issues"
  },
  "homepage": "https://github.com/AxDSan/HermesSpeaks#readme",
  "dependencies": {
    "chalk": "^4.1.2",
    "commander": "^12.1.0"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
